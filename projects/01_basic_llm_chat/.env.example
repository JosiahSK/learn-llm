# =============================================================
# Project 01 — Basic LLM Chat  |  Environment Configuration
# =============================================================
# Copy this file to .env and fill in the values you need.
# Only the key for your chosen provider is required.
# =============================================================

# Which provider to use: gemini | openrouter | ollama
LLM_PROVIDER=gemini

# ── Google Gemini ─────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# ── OpenRouter ────────────────────────────────────────────────
# Get a key at: https://openrouter.ai/keys
# Free models are marked "(free)" on https://openrouter.ai/models
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Ollama (local, no key needed) ─────────────────────────────
# Install: https://ollama.com  |  then: ollama pull llama3
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Optional system prompt ────────────────────────────────────
# Uncomment and edit to give the model a persona or instructions.
# LLM_SYSTEM_PROMPT=You are a helpful assistant who is concise and precise.
