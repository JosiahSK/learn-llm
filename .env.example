# ─────────────────────────────────────────────────────────────────────────────
# .env.example  — copy this file to .env and fill in your values.
# NEVER commit the actual .env file (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Active provider ──────────────────────────────────────────────────────────
# Choose: gemini | openrouter | ollama
LLM_PROVIDER=gemini

# ── Gemini (Google AI Studio) ─────────────────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/apikey
# Free tier available — check quotas at: https://ai.google.dev/pricing
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use. Verify current IDs at: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# ── OpenRouter ───────────────────────────────────────────────────────────────
# Get a key at: https://openrouter.ai/keys
# Free models available — check: https://openrouter.ai/models?q=:free
# WARNING: Free model availability changes. Verify before relying on a specific model.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# A free model currently available at OpenRouter (verified 2026-10-30):
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Ollama (local inference — no API key needed) ──────────────────────────────
# Install Ollama from: https://ollama.com/
# Run: ollama pull <model_name>   to download a model before using it.
# RAM requirements vary — check the model page for details.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding model for local use (run: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text
